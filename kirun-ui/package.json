{
    "name": "@fincity/kirun-ui",
    "version": "1.2.2",
    "description": "Visual and Text Editor UI for KIRun Function Definitions",
    "source": "src/index.ts",
    "main": "dist/index.js",
    "module": "dist/module.js",
    "types": "dist/types.d.ts",
    "style": "dist/kirun-ui.css",
    "files": [
        "dist"
    ],
    "targets": {
        "main": {
            "optimize": true,
            "isLibrary": true
        },
        "module": {
            "optimize": true,
            "isLibrary": true
        }
    },
    "scripts": {
        "watch": "parcel watch",
        "build": "parcel build",
        "test": "jest",
        "coverage": "jest --coverage",
        "tsc": "tsc",
        "pretty": "prettier --write ./src || prettier --write ./__tests__"
    },
    "keywords": [
        "kirun",
        "kirun-ui",
        "function-editor",
        "visual-editor"
    ],
    "author": "Kiran Kumar Grandhi",
    "license": "MIT",
    "peerDependencies": {
        "@fincity/kirun-js": ">=3.15.0",
        "monaco-editor": ">=0.40.0",
        "react": ">=17.0.0",
        "react-dom": ">=17.0.0"
    },
    "devDependencies": {
        "@fincity/kirun-js": "^3.15.0",
        "@parcel/packager-ts": "^2.16.3",
        "@parcel/transformer-typescript-types": "^2.16.3",
        "@tsconfig/recommended": "^1.0.13",
        "@types/jest": "^30.0.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "jest": "^30.4.2",
        "monaco-editor": "^0.56.0",
        "parcel": "^2.16.3",
        "prettier": "^3.9.6",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "ts-jest": "^29.4.12",
        "typescript": "^6.0.3"
    },
    "jest": {
        "transform": {
            ".(ts|tsx)": "ts-jest"
        },
        "testRegex": "(/__tests__/.*|\\.(test|spec))\\.(ts|tsx|js)$",
        "moduleFileExtensions": [
            "ts",
            "tsx",
            "js"
        ]
    },
    "dependencies": {
        "lucide-react": "^1.28.0"
    }
}
